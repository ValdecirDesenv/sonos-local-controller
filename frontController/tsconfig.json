{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "es2017"],
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "./src",
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/**/*.js"]
}
